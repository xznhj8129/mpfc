#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: sudo configure-fc <tty-device> [baud]

Examples:
  sudo configure-fc /dev/serial0 921600
  sudo configure-fc /dev/ttyUSB0 460800

Changes only the physical appliance MAVLink endpoint in /etc/mpfc/runtime.env
and restarts MPFC. Node identity and network configuration remain unchanged.
The VM supplies its own UDP override on the MPFC_CONFIG disk.
USAGE
}

if [[ ${EUID} -ne 0 ]]; then
    echo "configure-fc must run as root" >&2
    exit 1
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
    usage >&2
    exit 2
fi

TTY_DEVICE=$1
BAUD=${2:-921600}
RUNTIME_ENV=/etc/mpfc/runtime.env
CONNECTION="serial://${TTY_DEVICE}:${BAUD}"

if [[ ${TTY_DEVICE} != /dev/* ]]; then
    echo "tty device must be an absolute /dev path: ${TTY_DEVICE}" >&2
    exit 2
fi
if [[ ! ${BAUD} =~ ^[0-9]+$ ]]; then
    echo "baud must be numeric: ${BAUD}" >&2
    exit 2
fi
if [[ ! -f ${RUNTIME_ENV} ]]; then
    echo "missing appliance runtime configuration: ${RUNTIME_ENV}" >&2
    exit 1
fi

TMP=$(mktemp)
trap 'rm -f "${TMP}"' EXIT
awk -v connection="${CONNECTION}" '
    BEGIN { replaced = 0 }
    /^MPFC_MAVLINK_CONNECTION=/ {
        print "MPFC_MAVLINK_CONNECTION=" connection
        replaced = 1
        next
    }
    { print }
    END {
        if (!replaced) print "MPFC_MAVLINK_CONNECTION=" connection
    }
' "${RUNTIME_ENV}" > "${TMP}"
install -m 0644 "${TMP}" "${RUNTIME_ENV}"

usermod -a -G dialout mpfc
systemctl restart mpfc.service

echo "MPFC FC endpoint: ${CONNECTION}"
