# Standalone appliance defaults. A deployment manager may override any of these
# in the environment before invoking build-image or pi-vm.
: "${MPFC_PI_CONTROL_IP:=192.168.0.220}"
: "${MPFC_PI_GUEST_IP:=192.168.0.230}"
: "${MPFC_PI_PREFIX:=24}"
: "${MPFC_PI_BRIDGE:=cfbr0}"
: "${MPFC_PI_TAP:=cfmpfc0}"
: "${MPFC_HIVELINK_PORT:=5555}"
: "${MPFC_NODE_NAME:=uav1}"
: "${MPFC_CONTROL_NODE:=control}"
: "${MPFC_PI_PASSWORD:=mpfc}"
: "${MPFC_PI_VM_MAVLINK_CONNECTION:=udp://:14540}"
: "${MPFC_PI_PHYSICAL_MAVLINK_CONNECTION:=serial:///dev/serial0:921600}"
